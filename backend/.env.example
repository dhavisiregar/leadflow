APP_PORT=8080
APP_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=leadflow

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_HOURS=72

# Google OAuth (Continue with Google) — OAuth Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# CORS — comma-separated, e.g. https://yourapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
