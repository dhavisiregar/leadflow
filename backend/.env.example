APP_PORT=8080
APP_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=leadflow

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_HOURS=72

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# Resend (email alerts)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# CORS — comma-separated, e.g. https://yourapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
